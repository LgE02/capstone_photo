# 동화 삽화 생성 워커 환경 변수 템플릿
# 이 파일을 복사해 .env 로 만들고 실제 값 채우세요. .env 는 git에 올리지 마세요.

# ── GPT-4o (스토리 분석) ───────────────────────────────────
OPENAI_API_KEY=

# ── HuggingFace (FLUX.2-klein-4B 모델 다운로드) ────────────
HF_TOKEN=

# ── AWS S3 (삽화/레퍼런스 저장) ────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=

# ── Kafka (입력 토픽 2개 + 결과 토픽 1개) ──────────────────
# 입력 (consumer):
#   KAFKA_TOPIC_INIT   : 동화 생성 시 1번만 — 캐릭터 정보로 bible/레퍼런스 준비
#   KAFKA_TOPIC_PAGE   : 페이지마다 1번 — 실제 삽화 생성 + S3 업로드
# 결과 (producer):
#   KAFKA_TOPIC_RESULT : 페이지 생성 완료 시 {fairytaleId, pageNo, imageurl} 송신
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_INIT=fairytale_created
KAFKA_TOPIC_PAGE=fairytale_paragraph
KAFKA_TOPIC_RESULT=fairytale_image
KAFKA_GROUP_ID=illustration-worker
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
